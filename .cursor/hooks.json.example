{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "node -e \"const p=process.argv[1];const f=require('fs');if(f.existsSync(p)){const r=require('child_process').spawnSync(process.execPath,[p],{stdio:'inherit'});process.exit(r.status===null?1:r.status);}\" \".cursor/skills/impeccable/scripts/hook-before-edit.mjs\"",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "matcher": "Read|Grep|Glob|Search|Shell",
        "command": "node \".cursor/hooks/graft-hooks.cjs\" cursor-post-tool"
      }
    ],
    "afterMCPExecution": [
      {
        "command": "node \".cursor/hooks/graft-hooks.cjs\" cursor-mcp"
      }
    ],
    "sessionEnd": [
      {
        "command": "node \".cursor/hooks/graft-hooks.cjs\" cursor-session-end"
      }
    ]
  }
}
