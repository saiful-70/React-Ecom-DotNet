# =============================================================================
# DebuggerMind - Environment Configuration
# =============================================================================
# Copy this file to .env.local for development
# Copy this file to .env.production for production
# Update with your actual values
# DO NOT commit .env.local or .env.production to version control
# =============================================================================

# -----------------------------------------------------------------------------
# API CONFIGURATION (REQUIRED)
# -----------------------------------------------------------------------------
# Your backend API base URL
# Example: https://api.yourdomain.com or http://localhost:8000
API_BASE_URL=https://example-api.com

# Your backend API v1 endpoint
# Example: https://api.yourdomain.com/api/v1 or http://localhost:8000/api/v1
API_BASE_URL_V1=https://example-api.com/api/v1

# -----------------------------------------------------------------------------
# MULTI-WEBSITE / STORE IDENTITY (REQUIRED)
# -----------------------------------------------------------------------------
# One backend serves several storefronts. Every /api/v1 call sends
# `X-Website-Key`; the backend uses it to decide which products are visible and
# which store an order belongs to. Without it the API answers 401.
#
# Get a key from: Admin panel -> Setup & Configurations -> Websites
# (shown ONCE on create; use "Regenerate Key" if lost).
#
# SERVER-ONLY — do NOT add a NEXT_PUBLIC_ prefix. All API calls are made from
# the Next server, so the key must never reach the browser bundle.
#
# Deployment-wide fallback, used by any variant without its own key.
WEBSITE_KEY=

# Optional per-variant keys — this repo can serve several storefronts from one
# deployment, so each variant may map to its own website in the backend admin.
# A variant with no key here falls back to WEBSITE_KEY above.
WEBSITE_KEY_BN_01=
WEBSITE_KEY_BN_02=
WEBSITE_KEY_BN_03=
WEBSITE_KEY_INTL_01=
WEBSITE_KEY_INTL_02=

# Development seed keys (from the Multi_Website_Support.sql migration):
#   website1  ws1_live_a7f3c9e2b1d84f6a9c0e5d2b8f4a1c7e
#   website2  ws2_live_b8e4d0f3c2e95a7b0d1f6e3c9a5b2d8f
#   website3  ws3_live_c9f5e1a4d3f06b8c1e2a7f4d0b6c3e9a
# Never use these in production — issue real keys from the admin panel.

# -----------------------------------------------------------------------------
# SITE CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# Your site's public URL (used for SEO and metadata)
# Example: https://yourdomain.com or http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# VARIANTS / DEMO SHOWCASE (OPTIONAL)
# -----------------------------------------------------------------------------
# A "variant" is one demo/deployment of the storefront (theme + feature flags +
# branding), defined as data under app/variants/. Two run modes:
#
#   Showcase (browse all demos):  NEXT_PUBLIC_SHOWCASE=true
#     Every variant is reachable at /demo/<id>/... with a gallery + switcher.
#
#   Client deploy (pin one demo): NEXT_PUBLIC_SHOWCASE unset, ACTIVE_VARIANT set
#     App is served at /... with no prefix and no switcher.
#
# Enable the browsable showcase (default: off).
NEXT_PUBLIC_SHOWCASE=

# Pin a single variant for a client deployment, e.g. bn-01 / intl-01.
# Server-only — must NOT have a NEXT_PUBLIC_ prefix.
ACTIVE_VARIANT=

# Variant used when none is resolved from the URL/env. Default: bn-01.
NEXT_PUBLIC_DEFAULT_VARIANT=

# -----------------------------------------------------------------------------
# ENVIRONMENT (OPTIONAL)
# -----------------------------------------------------------------------------
# Current environment: development, production, or test
# Default: development
NODE_ENV=development

# -----------------------------------------------------------------------------
# ANALYTICS & TRACKING (OPTIONAL)
# -----------------------------------------------------------------------------
# Google Analytics 4 Measurement ID
# Get from: https://analytics.google.com/ → Admin → Data Streams
# Format: G-XXXXXXXXXX
# Leave empty to disable Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (Facebook Pixel)
# Get from: https://business.facebook.com/events_manager → Settings
# Format: numeric ID (e.g., 1234567890123456)
# Leave empty to disable Meta Pixel tracking
NEXT_PUBLIC_META_PIXEL_ID=

# Meta Conversions API (server-side, recovers ad-blocker / iOS losses)
# Get from: Events Manager → Settings → Conversions API → Generate Access Token
# Server-only — must NOT have NEXT_PUBLIC_ prefix
META_CAPI_ACCESS_TOKEN=

# Optional: test event code for Events Manager → Test Events tab
# Remove in production — events sent with this code don't count for ads
META_CAPI_TEST_EVENT_CODE=

# Optional: Graph API version (default: v19.0)
META_CAPI_GRAPH_VERSION=

# -----------------------------------------------------------------------------
# ADDITIONAL NOTES
# -----------------------------------------------------------------------------
# - All environment variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Other variables are only available on the server side
# - Restart the development server after changing this file
# - For production, set these in your hosting platform's environment settings
# =============================================================================
